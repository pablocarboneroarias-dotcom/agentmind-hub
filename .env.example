# ---- Routing de modelos (LiteLLM) ----
# Si usas tu proxy LiteLLM del Mac Mini (recomendado, respeta tus perfiles):
USE_LITELLM_PROXY=true
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-anything

# Si prefieres saltarte el proxy y llamar directo a proveedores:
#   USE_LITELLM_PROXY=false
#   (y define abajo las claves que necesites)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama local no necesita clave (Qwen 8B via ollama/qwen3:8b)

# ---- Observabilidad (LangSmith) ----
# Déjalo vacío y todo funciona igual, pero sin trazas.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentmind-hub
